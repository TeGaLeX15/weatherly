<!--  Views/Components/WeatherHero.axaml  -->
<UserControl
    x:Class="Weatherly.Views.Components.WeatherHero"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
    xmlns:vm="using:Weatherly.ViewModels"
    x:DataType="vm:MainViewModel">

    <!--  ========================================  -->
    <!--  HERO CARD  -->
    <!--  ========================================  -->

    <Border
        Padding="30"
        Classes="weather-hero-card"
        ClipToBounds="True">

        <Grid MinHeight="0" RowDefinitions="70,1*,64">

            <!--  Header  -->
            <Grid
                Grid.Row="0"
                MinWidth="0"
                VerticalAlignment="Top"
                ColumnDefinitions="1*,Auto">

                <StackPanel
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Spacing="5">

                    <TextBlock
                        MaxWidth="380"
                        FontFamily="Inter"
                        FontSize="24"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource BrushTextPrimary}"
                        Text="{Binding CityName}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />

                    <TextBlock
                        MaxWidth="380"
                        FontFamily="Inter"
                        FontSize="11"
                        FontWeight="Normal"
                        Foreground="{StaticResource BrushTextMuted}"
                        Text="{Binding DateText}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />

                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">

                    <Border
                        Width="7"
                        Height="7"
                        HorizontalAlignment="Right"
                        Background="{StaticResource BrushSuccess}"
                        CornerRadius="4" />

                    <TextBlock
                        HorizontalAlignment="Right"
                        FontFamily="Inter"
                        FontSize="9"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource BrushTextMuted}"
                        Text="СЕЙЧАС" />

                </StackPanel>

            </Grid>


            <!--  Main content  -->
            <Grid
                Grid.Row="1"
                MinWidth="0"
                MinHeight="0"
                Margin="0,8,0,8"
                ColumnDefinitions="1.1*,0.9*"
                ColumnSpacing="20">

                <!--  Left column  -->
                <Grid
                    Grid.Column="0"
                    MinWidth="0"
                    MinHeight="0"
                    VerticalAlignment="Center"
                    RowDefinitions="82,Auto,Auto">

                    <Grid
                        Grid.Row="0"
                        MinHeight="82"
                        MaxHeight="82"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top">

                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontFamily="Inter"
                            FontSize="58"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource BrushTextPrimary}"
                            Text="{Binding CurrentTemperature}"
                            TextWrapping="NoWrap" />

                    </Grid>

                    <TextBlock
                        Grid.Row="1"
                        MaxWidth="310"
                        Margin="0,3,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        FontFamily="Inter"
                        FontSize="12"
                        FontWeight="Medium"
                        Foreground="{StaticResource BrushTextPrimary}"
                        Text="{Binding CurrentCondition}"
                        TextWrapping="Wrap" />

                </Grid>


                <!--  Right column  -->
                <Grid
                    Grid.Column="1"
                    MinWidth="0"
                    MinHeight="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">

                    <svg:Svg
                        Width="165"
                        Height="165"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        AnimationBackend="Default"
                        AnimationFrameInterval="0:0:0.016"
                        AnimationPlaybackRate="1"
                        EnableCache="True"
                        Path="{Binding CurrentIconPath}"
                        Stretch="Uniform" />

                </Grid>

            </Grid>


            <!--  Bottom area  -->
            <Grid
                Grid.Row="2"
                VerticalAlignment="Bottom"
                RowDefinitions="1,Auto"
                RowSpacing="12">

                <Border
                    Grid.Row="0"
                    Height="1"
                    HorizontalAlignment="Stretch"
                    Background="{StaticResource BrushBorderSoft}" />

                <Grid
                    Grid.Row="1"
                    MinHeight="0"
                    ColumnDefinitions="1*,1,1*"
                    ColumnSpacing="18">

                    <StackPanel
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Spacing="3">

                        <TextBlock Classes="text-section-label" Text="СЕГОДНЯ" />

                        <TextBlock
                            FontFamily="Inter"
                            FontSize="14"
                            FontWeight="Medium"
                            Foreground="{StaticResource BrushTextSecondary}"
                            Text="{Binding TodayMinMax}"
                            TextWrapping="NoWrap" />

                    </StackPanel>

                    <Border
                        Grid.Column="1"
                        Width="1"
                        Height="28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{StaticResource BrushBorderSoft}" />

                    <StackPanel
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Spacing="3">

                        <TextBlock
                            HorizontalAlignment="Right"
                            Classes="text-section-label"
                            Text="ОЩУЩАЕТСЯ" />

                        <TextBlock
                            HorizontalAlignment="Right"
                            FontFamily="Inter"
                            FontSize="14"
                            FontWeight="Medium"
                            Foreground="{StaticResource BrushTextSecondary}"
                            Text="{Binding FeelsLike}"
                            TextWrapping="NoWrap" />

                    </StackPanel>

                </Grid>

            </Grid>

        </Grid>

    </Border>

</UserControl>
