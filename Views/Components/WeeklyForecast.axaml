<!--  Views/Components/WeeklyForecast.axaml  -->
<UserControl
    x:Class="Weatherly.Views.Components.WeeklyForecast"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
    xmlns:vm="using:Weatherly.ViewModels"
    x:DataType="vm:MainViewModel">

    <!--  ========================================  -->
    <!--  WEEKLY FORECAST  -->
    <!--  ========================================  -->

    <Border
        Padding="22,18"
        Classes="weather-hero-card"
        ClipToBounds="True">

        <Grid RowDefinitions="Auto,1,*" RowSpacing="15">

            <!--  Header  -->
            <Grid
                Grid.Row="0"
                VerticalAlignment="Center"
                ColumnDefinitions="*,Auto">

                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Spacing="2">

                    <TextBlock
                        FontFamily="Inter"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource BrushTextPrimary}"
                        Text="Прогноз на неделю" />

                    <TextBlock
                        FontFamily="Inter"
                        FontSize="10"
                        FontWeight="Medium"
                        Foreground="{StaticResource BrushTextMuted}"
                        Text="Погода на ближайшие 7 дней" />

                </StackPanel>

                <Border
                    Grid.Column="1"
                    Padding="10,5"
                    VerticalAlignment="Center"
                    Background="{StaticResource BrushGlassSoft}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="9">

                    <TextBlock
                        FontFamily="Inter"
                        FontSize="9"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource BrushAccent}"
                        Text="7 ДНЕЙ" />

                </Border>

            </Grid>


            <Border
                Grid.Row="1"
                Height="1"
                HorizontalAlignment="Stretch"
                Background="{StaticResource BrushBorderSoft}" />


            <!--  Days  -->
            <ItemsControl
                Grid.Row="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ItemsSource="{Binding Daily}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>

                        <UniformGrid
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Columns="7"
                            Rows="1" />

                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DailyWeatherItem">

                        <Grid Margin="1,0">

                            <Grid
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                RowDefinitions="Auto,Auto,104,Auto"
                                RowSpacing="5">

                                <TextBlock
                                    Grid.Row="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Inter"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource BrushTextPrimary}"
                                    Text="{Binding Day}"
                                    TextWrapping="NoWrap" />

                                <TextBlock
                                    Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Inter"
                                    FontSize="10"
                                    FontWeight="Medium"
                                    Foreground="{StaticResource BrushTextMuted}"
                                    Text="{Binding Date}"
                                    TextWrapping="NoWrap" />

                                <Grid
                                    Grid.Row="2"
                                    Width="104"
                                    Height="104"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                                    <Ellipse
                                        Width="86"
                                        Height="86"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Fill="{StaticResource BrushWeatherGlow}"
                                        Opacity="0.11" />

                                    <svg:Svg
                                        Width="104"
                                        Height="104"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        AnimationBackend="Default"
                                        AnimationFrameInterval="0:0:0.016"
                                        AnimationPlaybackRate="1"
                                        EnableCache="True"
                                        Path="{Binding IconPath}"
                                        Stretch="Uniform" />

                                </Grid>

                                <TextBlock
                                    Grid.Row="3"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Inter"
                                    FontSize="19"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource BrushTextPrimary}"
                                    Text="{Binding Temperature}"
                                    TextWrapping="NoWrap" />

                            </Grid>

                            <Border
                                Width="1"
                                Height="72"
                                Margin="0,4,0,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="{StaticResource BrushBorderSoft}"
                                Opacity="0.65" />

                        </Grid>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </Grid>

    </Border>

</UserControl>
