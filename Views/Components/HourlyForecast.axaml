<!--  Views/Components/HourlyForecast.axaml  -->
<UserControl
    x:Class="Weatherly.Views.Components.HourlyForecast"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
    xmlns:vm="using:Weatherly.ViewModels"
    x:DataType="vm:MainViewModel">

    <!--  ========================================  -->
    <!--  HOURLY FORECAST  -->
    <!--  ========================================  -->

    <Border
        Padding="22,18"
        Classes="weather-hero-card"
        ClipToBounds="True">

        <Grid RowDefinitions="Auto,1,*" RowSpacing="15">

            <!--  Header  -->
            <Grid
                Grid.Row="0"
                VerticalAlignment="Center"
                ColumnDefinitions="*,Auto">

                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Spacing="2">

                    <TextBlock
                        FontFamily="Inter"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource BrushTextPrimary}"
                        Text="Прогноз по часам" />

                    <TextBlock
                        FontFamily="Inter"
                        FontSize="10"
                        FontWeight="Medium"
                        Foreground="{StaticResource BrushTextMuted}"
                        Text="Погода на ближайшие часы" />

                </StackPanel>

                <Border
                    Grid.Column="1"
                    Padding="10,5"
                    VerticalAlignment="Center"
                    Background="{StaticResource BrushGlassSoft}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="9">

                    <TextBlock
                        FontFamily="Inter"
                        FontSize="9"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource BrushAccent}"
                        Text="СЕГОДНЯ" />

                </Border>

            </Grid>


            <!--  Header divider  -->
            <Border
                Grid.Row="1"
                Height="1"
                HorizontalAlignment="Stretch"
                Background="{StaticResource BrushBorderSoft}" />


            <!--  Hourly content  -->
            <ItemsControl
                Grid.Row="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ItemsSource="{Binding Hourly}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Columns="6"
                            Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HourlyWeatherItem">

                        <!--  Hourly item  -->
                        <Grid Margin="1,0">

                            <Grid
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                RowDefinitions="Auto,112,Auto,Auto"
                                RowSpacing="5">

                                <TextBlock
                                    Grid.Row="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Inter"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource BrushTextSecondary}"
                                    Text="{Binding Time}"
                                    TextWrapping="NoWrap" />

                                <Grid
                                    Grid.Row="1"
                                    Width="112"
                                    Height="112"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                                    <Ellipse
                                        Width="92"
                                        Height="92"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Fill="{StaticResource BrushWeatherGlow}"
                                        Opacity="0.11" />

                                    <svg:Svg
                                        Width="112"
                                        Height="112"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        AnimationBackend="Default"
                                        AnimationFrameInterval="0:0:0.016"
                                        AnimationPlaybackRate="1"
                                        EnableCache="True"
                                        Path="{Binding IconPath}"
                                        Stretch="Uniform" />

                                </Grid>

                                <TextBlock
                                    Grid.Row="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Inter"
                                    FontSize="21"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource BrushTextPrimary}"
                                    Text="{Binding Temperature}"
                                    TextWrapping="NoWrap" />

                                <StackPanel
                                    Grid.Row="3"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="5">

                                    <Border
                                        Width="5"
                                        Height="5"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource BrushAccent}"
                                        CornerRadius="3" />

                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="Inter"
                                        FontSize="10"
                                        FontWeight="Medium"
                                        Foreground="{StaticResource BrushTextMuted}"
                                        Text="{Binding PrecipitationProbability}"
                                        TextWrapping="NoWrap" />

                                </StackPanel>

                            </Grid>

                            <!--  Column divider  -->
                            <Border
                                Width="1"
                                Height="76"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="{StaticResource BrushBorderSoft}"
                                Opacity="0.60" />

                        </Grid>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </Grid>

    </Border>

</UserControl>
