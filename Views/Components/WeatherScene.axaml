<!--  Views/Components/WeatherScene.axaml  -->
<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
    x:Class="Weatherly.Views.Components.WeatherScene">

    <Border
        Background="#151B26"
        CornerRadius="24"
        ClipToBounds="True">

        <Grid>

            <svg:Svg
                x:Name="WeatherIcon"
                Path="/Assets/Weather/overcast.svg"
                Width="240"
                Height="240"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Stretch="Uniform"
                EnableCache="True"
                AnimationBackend="Default"
                AnimationPlaybackRate="1"
                AnimationFrameInterval="0:0:0.016" />

        </Grid>

    </Border>

</UserControl>