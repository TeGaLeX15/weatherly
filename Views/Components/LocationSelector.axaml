<!--  Views/Components/LocationSelector.axaml  -->
<UserControl
    x:Class="Weatherly.Views.Components.LocationSelector"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
    xmlns:vm="using:Weatherly.ViewModels"
    x:DataType="vm:MainViewModel">

    <!--  ========================================  -->
    <!--  LOCATION SELECTOR  -->
    <!--  ========================================  -->

    <Button
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Classes="location-selector">

        <!--  Location content  -->
        <Border
            Padding="12,9"
            Background="{StaticResource BrushGlassSoft}"
            BorderBrush="{StaticResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="15">

            <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="10">

                <Border
                    Grid.Column="0"
                    Width="36"
                    Height="36"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource BrushGlass}"
                    CornerRadius="11">

                    <svg:Svg
                        Width="17"
                        Height="17"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Path="/Assets/Icons/location.svg"
                        Stretch="Uniform" />

                </Border>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="1">

                    <TextBlock
                        FontFamily="Inter"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource BrushTextPrimary}"
                        Text="{Binding CityName}"
                        TextTrimming="CharacterEllipsis" />

                    <StackPanel Orientation="Horizontal" Spacing="5">

                        <Ellipse
                            Width="5"
                            Height="5"
                            VerticalAlignment="Center"
                            Fill="{StaticResource BrushSuccess}" />

                        <TextBlock
                            FontFamily="Inter"
                            FontSize="9"
                            Foreground="{StaticResource BrushTextMuted}"
                            Text="Текущее местоположение" />

                    </StackPanel>

                </StackPanel>

                <svg:Svg
                    Grid.Column="2"
                    Width="16"
                    Height="16"
                    Margin="8,0,2,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Path="/Assets/Icons/chevron-down.svg"
                    Stretch="Uniform" />

            </Grid>

        </Border>

    </Button>

</UserControl>
