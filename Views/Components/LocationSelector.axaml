<!--  Views/Components/LocationSelector.axaml  -->
<UserControl
    x:Class="Weatherly.Views.Components.LocationSelector"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Weatherly.Models"
    xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
    xmlns:vm="using:Weatherly.ViewModels"
    x:DataType="vm:MainViewModel">

    <Grid>

        <Button
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Classes="location-selector"
            Click="LocationButton_OnClick">

            <Border
                Padding="12,9"
                Background="{StaticResource BrushGlassSoft}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="15">

                <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="10">

                    <Border
                        Grid.Column="0"
                        Width="36"
                        Height="36"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{StaticResource BrushGlass}"
                        CornerRadius="11">

                        <svg:Svg
                            Width="17"
                            Height="17"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Path="/Assets/Icons/location.svg"
                            Stretch="Uniform" />

                    </Border>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="1">

                        <TextBlock
                            FontFamily="Inter"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource BrushTextPrimary}"
                            Text="{Binding CityName}"
                            TextTrimming="CharacterEllipsis" />

                        <StackPanel Orientation="Horizontal" Spacing="5">

                            <Ellipse
                                Width="5"
                                Height="5"
                                VerticalAlignment="Center"
                                Fill="{StaticResource BrushSuccess}" />

                            <TextBlock
                                FontFamily="Inter"
                                FontSize="9"
                                Foreground="{StaticResource BrushTextMuted}"
                                Text="Выбранный город" />

                        </StackPanel>

                    </StackPanel>

                    <svg:Svg
                        Grid.Column="2"
                        Width="16"
                        Height="16"
                        Margin="8,0,2,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Path="/Assets/Icons/chevron-down.svg"
                        Stretch="Uniform" />

                </Grid>

            </Border>

        </Button>

        <Popup
            Name="LocationPopup"
            IsLightDismissEnabled="True"
            IsOpen="{Binding IsLocationPickerOpen}"
            Placement="Bottom"
            PlacementTarget="{Binding $parent[UserControl]}">

            <Border
                Width="320"
                Margin="0,10,0,0"
                Padding="12"
                Background="{StaticResource BrushSurfaceElevated}"
                BorderBrush="{StaticResource BrushBorderStrong}"
                BorderThickness="1"
                BoxShadow="0 24 60 0 #90000000"
                CornerRadius="20">

                <StackPanel>

                    <!--  Search  -->
                    <Border
                        Height="44"
                        Background="{StaticResource BrushGlass}"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="13">

                        <Grid ColumnDefinitions="36,*">

                            <svg:Svg
                                Grid.Column="0"
                                Width="17"
                                Height="17"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Path="/Assets/Icons/search.svg"
                                Stretch="Uniform" />

                            <TextBox
                                Name="SearchTextBox"
                                Grid.Column="1"
                                Padding="0,1,12,0"
                                VerticalContentAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                FontFamily="Inter"
                                FontSize="13"
                                Foreground="{StaticResource BrushTextPrimary}"
                                PlaceholderText="Поиск города..."
                                SelectionBrush="{StaticResource BrushAccent}"
                                TextChanged="SearchTextBox_OnTextChanged" />

                        </Grid>

                    </Border>

                    <!--  Results  -->
                    <ScrollViewer
                        MaxHeight="320"
                        Margin="0,8,0,0"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">

                        <ItemsControl ItemsSource="{Binding SearchResults}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate x:DataType="models:Location">

                                    <Button
                                        Height="64"
                                        HorizontalContentAlignment="Stretch"
                                        Classes="location-result"
                                        Click="LocationResult_OnClick"
                                        Tag="{Binding}">

                                        <Grid
                                            Margin="4,0"
                                            ColumnDefinitions="40,*,Auto"
                                            ColumnSpacing="12">

                                            <Border
                                                Grid.Column="0"
                                                Width="34"
                                                Height="34"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource BrushGlass}"
                                                CornerRadius="10">

                                                <svg:Svg
                                                    Width="15"
                                                    Height="15"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Path="/Assets/Icons/location.svg"
                                                    Stretch="Uniform" />

                                            </Border>

                                            <StackPanel
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Spacing="4">

                                                <TextBlock
                                                    FontFamily="Inter"
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource BrushTextPrimary}"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis" />

                                                <TextBlock
                                                    FontFamily="Inter"
                                                    FontSize="10"
                                                    Foreground="{StaticResource BrushTextMuted}"
                                                    Text="{Binding Admin1}"
                                                    TextTrimming="CharacterEllipsis" />

                                            </StackPanel>

                                            <TextBlock
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                FontFamily="Inter"
                                                FontSize="10"
                                                Foreground="{StaticResource BrushTextMuted}"
                                                Text="{Binding CountryCode}"
                                                TextTrimming="CharacterEllipsis" />

                                        </Grid>

                                    </Button>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </ScrollViewer>

                </StackPanel>

            </Border>

        </Popup>

    </Grid>

</UserControl>
