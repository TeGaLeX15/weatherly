<!-- Views/Components/LocationSelector.axaml -->

<UserControl
    x:Class="Weatherly.Views.Components.LocationSelector"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Weatherly.ViewModels"
    x:DataType="vm:MainViewModel">

    <Border
        Padding="10,7"
        Background="{StaticResource BrushGlassSoft}"
        BorderBrush="{StaticResource BrushBorder}"
        BorderThickness="1"
        CornerRadius="14">

        <Grid
            VerticalAlignment="Center"
            ColumnDefinitions="Auto,*,Auto">


            <!-- ================================================= -->
            <!-- LOCATION ICON                                     -->
            <!-- ================================================= -->

            <Border
                Grid.Column="0"
                Width="30"
                Height="30"
                Background="{StaticResource BrushGlass}"
                BorderBrush="{StaticResource BrushBorderSoft}"
                BorderThickness="1"
                CornerRadius="9">

                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="{StaticResource BrushAccent}"
                    Text="⌖" />

            </Border>


            <!-- ================================================= -->
            <!-- LOCATION TEXT                                     -->
            <!-- ================================================= -->

            <StackPanel
                Grid.Column="1"
                Margin="10,0"
                Spacing="1">

                <TextBlock
                    FontFamily="Inter"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource BrushTextPrimary}"
                    Text="{Binding CityName}" />

                <TextBlock
                    FontFamily="Inter"
                    FontSize="8"
                    Foreground="{StaticResource BrushTextMuted}"
                    Text="Текущее местоположение" />

            </StackPanel>


            <!-- ================================================= -->
            <!-- ARROW                                              -->
            <!-- ================================================= -->

            <TextBlock
                Grid.Column="2"
                Margin="4,0,2,0"
                VerticalAlignment="Center"
                FontSize="13"
                Foreground="{StaticResource BrushTextMuted}"
                Text="⌄" />

        </Grid>

    </Border>

</UserControl>