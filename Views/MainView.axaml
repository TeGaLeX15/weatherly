<!--  Views/MainView.axaml  -->
<UserControl
    x:Class="Weatherly.Views.MainView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:Weatherly.Views.Components"
    xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
    xmlns:vm="using:Weatherly.ViewModels"
    x:DataType="vm:MainViewModel">

    <Grid>

        <!--  Main content  -->
        <Border Padding="24">

            <Grid RowDefinitions="54,1*,82,1.05*" RowSpacing="14">

                <!--  Header  -->
                <Grid
                    Grid.Row="0"
                    VerticalAlignment="Center"
                    ColumnDefinitions="Auto,1*,Auto">

                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="9">

                        <svg:Svg
                            Width="24"
                            Height="24"
                            VerticalAlignment="Center"
                            Path="/Assets/Icons/weatherly-mark.svg"
                            Stretch="Uniform" />

                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="Inter"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource BrushTextPrimary}"
                            Text="Weatherly" />

                    </StackPanel>

                    <components:LocationSelector
                        Grid.Column="1"
                        Width="300"
                        HorizontalAlignment="Center" />

                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="8">

                        <Button
                            Classes="icon-button"
                            Click="RefreshButton_OnClick"
                            ToolTip.Tip="Обновить">

                            <svg:Svg
                                Width="18"
                                Height="18"
                                Path="/Assets/Icons/refresh.svg"
                                Stretch="Uniform" />

                        </Button>

                        <Button
                            Classes="icon-button"
                            Click="SettingsButton_OnClick"
                            ToolTip.Tip="Настройки">

                            <svg:Svg
                                Width="18"
                                Height="18"
                                Path="/Assets/Icons/settings.svg"
                                Stretch="Uniform" />

                        </Button>

                    </StackPanel>

                </Grid>


                <!--  Hero + hourly  -->
                <Grid
                    Grid.Row="1"
                    ColumnDefinitions="0.92*,1.65*"
                    ColumnSpacing="14">

                    <components:WeatherHero Grid.Column="0" />
                    <components:HourlyForecast Grid.Column="1" />

                </Grid>


                <!--  Metrics  -->
                <components:WeatherMetrics Grid.Row="2" />


                <!--  Weekly + insight  -->
                <Grid
                    Grid.Row="3"
                    ColumnDefinitions="1.75*,1*"
                    ColumnSpacing="14">

                    <components:WeeklyForecast Grid.Column="0" />
                    <components:WeatherInsight Grid.Column="1" />

                </Grid>


                <!--  Loading overlay  -->
                <Border
                    Grid.RowSpan="4"
                    Background="#9906080D"
                    IsVisible="{Binding IsLoading}"
                    ZIndex="100">

                    <Border
                        Padding="28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{StaticResource BrushGlassElevated}"
                        BorderBrush="{StaticResource BrushBorderStrong}"
                        BorderThickness="1"
                        BoxShadow="0 20 60 0 #80000000"
                        CornerRadius="20">

                        <StackPanel HorizontalAlignment="Center" Spacing="14">

                            <ProgressBar
                                Width="180"
                                Height="4"
                                IsIndeterminate="True" />

                            <TextBlock
                                HorizontalAlignment="Center"
                                Classes="text-small"
                                Text="Обновляем погоду…" />

                        </StackPanel>

                    </Border>

                </Border>

            </Grid>

        </Border>

    </Grid>

</UserControl>
