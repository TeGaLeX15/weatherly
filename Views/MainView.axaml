<!--  Views/MainView.axaml  -->
<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
    xmlns:components="using:Weatherly.Views.Components"
    xmlns:vm="using:Weatherly.ViewModels"
    x:Class="Weatherly.Views.MainView"
    x:DataType="vm:MainViewModel">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">

        <Grid
            MaxWidth="1140"
            Margin="24"
            HorizontalAlignment="Center"
            RowDefinitions="Auto,Auto,Auto,Auto,Auto"
            RowSpacing="18">


            <!-- HEADER -->

            <Grid
                Grid.Row="0"
                ColumnDefinitions="*,Auto"
                VerticalAlignment="Center">

                <StackPanel
                    Grid.Column="0"
                    Spacing="2">

                    <TextBlock
                        FontSize="26"
                        FontWeight="SemiBold"
                        Foreground="#F4F6FA"
                        Text="{Binding CityName}" />

                    <TextBlock
                        FontSize="13"
                        Foreground="#8E96A6"
                        Text="{Binding DateText}" />

                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="6">

                    <Button
                        Width="40"
                        Height="40"
                        Padding="0"
                        Background="#151A24"
                        BorderBrush="#232B38"
                        BorderThickness="1"
                        CornerRadius="11"
                        Content="↻"
                        FontSize="19"
                        Foreground="#B7BECA"
                        Click="RefreshButton_OnClick" />

                    <Button
                        Width="40"
                        Height="40"
                        Padding="0"
                        Background="#151A24"
                        BorderBrush="#232B38"
                        BorderThickness="1"
                        CornerRadius="11"
                        Content="⚙"
                        FontSize="17"
                        Foreground="#B7BECA" />

                </StackPanel>

            </Grid>


            <!-- CURRENT WEATHER -->

            <Border
                Grid.Row="1"
                Background="#151A24"
                BorderBrush="#232B38"
                BorderThickness="1"
                CornerRadius="22"
                Padding="22">

                <Grid
                    ColumnDefinitions="*,280"
                    VerticalAlignment="Center">

                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Spacing="9">

                        <TextBlock
                            FontSize="58"
                            FontWeight="SemiBold"
                            Foreground="#F4F6FA"
                            Text="{Binding CurrentTemperature}" />

                        <TextBlock
                            FontSize="20"
                            Foreground="#E8ECF2"
                            Text="{Binding CurrentCondition}" />

                        <TextBlock
                            FontSize="14"
                            Foreground="#8E96A6"
                            Text="{Binding FeelsLike}" />

                        <Grid
                            Margin="0,8,0,0"
                            ColumnDefinitions="Auto,Auto,Auto"
                            ColumnSpacing="24">

                            <StackPanel
                                Grid.Column="0"
                                Spacing="2">

                                <TextBlock
                                    FontSize="11"
                                    Foreground="#737C8C"
                                    Text="Сегодня" />

                                <TextBlock
                                    FontSize="15"
                                    Foreground="#B7BECA"
                                    Text="{Binding TodayMinMax}" />

                            </StackPanel>

                            <StackPanel
                                Grid.Column="1"
                                Spacing="2">

                                <TextBlock
                                    FontSize="11"
                                    Foreground="#737C8C"
                                    Text="Ветер" />

                                <TextBlock
                                    FontSize="15"
                                    Foreground="#B7BECA"
                                    Text="{Binding Wind}" />

                            </StackPanel>

                            <StackPanel
                                Grid.Column="2"
                                Spacing="2">

                                <TextBlock
                                    FontSize="11"
                                    Foreground="#737C8C"
                                    Text="Влажность" />

                                <TextBlock
                                    FontSize="15"
                                    Foreground="#B7BECA"
                                    Text="{Binding Humidity}" />

                            </StackPanel>

                        </Grid>

                    </StackPanel>


                    <Border
                        Grid.Column="1"
                        Background="#151B26"
                        CornerRadius="20"
                        ClipToBounds="True">

                        <svg:Svg
                            Width="240"
                            Height="240"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Stretch="Uniform"
                            EnableCache="True"
                            AnimationBackend="Default"
                            AnimationFrameInterval="0:0:0.016"
                            AnimationPlaybackRate="1"
                            Path="{Binding CurrentIconPath}" />

                    </Border>

                </Grid>

            </Border>


            <!-- HOURLY -->

            <StackPanel
                Grid.Row="2"
                Spacing="9">

                <TextBlock
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="#F4F6FA"
                    Text="Почасовой прогноз" />

                <ScrollViewer
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled">

                    <ItemsControl ItemsSource="{Binding Hourly}">

                        <ItemsControl.ItemsPanel>

                            <ItemsPanelTemplate>
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="8" />
                            </ItemsPanelTemplate>

                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>

                            <DataTemplate
                                x:DataType="vm:HourlyWeatherItem">

                                <Border
                                    Width="142"
                                    Height="196"
                                    Padding="6"
                                    Background="#18202C"
                                    CornerRadius="16">

                                    <Grid
                                        RowDefinitions="Auto,128,Auto"
                                        VerticalAlignment="Center">

                                        <TextBlock
                                            Grid.Row="0"
                                            HorizontalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#8E96A6"
                                            Text="{Binding Time}" />

                                        <svg:Svg
                                            Grid.Row="1"
                                            Width="128"
                                            Height="128"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Stretch="Uniform"
                                            EnableCache="True"
                                            AnimationBackend="Default"
                                            AnimationFrameInterval="0:0:0.016"
                                            AnimationPlaybackRate="1"
                                            Path="{Binding IconPath}" />

                                        <TextBlock
                                            Grid.Row="2"
                                            HorizontalAlignment="Center"
                                            FontSize="18"
                                            FontWeight="SemiBold"
                                            Foreground="#F4F6FA"
                                            Text="{Binding Temperature}" />

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </ScrollViewer>

            </StackPanel>


            <!-- ANALYSIS -->

            <Grid
                Grid.Row="3"
                ColumnDefinitions="*,*"
                ColumnSpacing="12">

                <Border
                    Grid.Column="0"
                    Background="#151A24"
                    BorderBrush="#232B38"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="18">

                    <StackPanel Spacing="9">

                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="#F4F6FA"
                            Text="Анализ дня" />

                        <TextBlock
                            FontSize="14"
                            Foreground="#B7BECA"
                            TextWrapping="Wrap"
                            Text="{Binding AnalysisText}" />

                        <Border
                            Padding="10"
                            Background="#18202C"
                            CornerRadius="10">

                            <StackPanel Spacing="2">

                                <TextBlock
                                    FontSize="11"
                                    Foreground="#737C8C"
                                    Text="Лучшее время для прогулки" />

                                <TextBlock
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="#E8ECF2"
                                    Text="{Binding BestWalkTime}" />

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </Border>


                <Border
                    Grid.Column="1"
                    Background="#151A24"
                    BorderBrush="#232B38"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="18">

                    <StackPanel Spacing="9">

                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="#F4F6FA"
                            Text="Что надеть" />

                        <TextBlock
                            FontSize="14"
                            Foreground="#B7BECA"
                            TextWrapping="Wrap"
                            Text="{Binding ClothingText}" />

                        <Border
                            Padding="10"
                            Background="#18202C"
                            CornerRadius="10">

                            <StackPanel Spacing="2">

                                <TextBlock
                                    FontSize="11"
                                    Foreground="#737C8C"
                                    Text="Совет" />

                                <TextBlock
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="#E8ECF2"
                                    TextWrapping="Wrap"
                                    Text="{Binding WeatherTip}" />

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </Border>

            </Grid>


            <!-- WEEKLY -->

            <Border
                Grid.Row="4"
                Background="#151A24"
                BorderBrush="#232B38"
                BorderThickness="1"
                CornerRadius="18"
                Padding="18">

                <StackPanel Spacing="14">

                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="#F4F6FA"
                        Text="Прогноз на 7 дней" />

                    <ScrollViewer
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled">

                        <ItemsControl ItemsSource="{Binding Daily}">

                            <ItemsControl.ItemsPanel>

                                <ItemsPanelTemplate>
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="6" />
                                </ItemsPanelTemplate>

                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>

                                <DataTemplate
                                    x:DataType="vm:DailyWeatherItem">

                                    <StackPanel
                                        Width="142"
                                        HorizontalAlignment="Center"
                                        Spacing="5">

                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#8E96A6"
                                            Text="{Binding Day}" />

                                        <svg:Svg
                                            Width="128"
                                            Height="128"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Stretch="Uniform"
                                            EnableCache="True"
                                            AnimationBackend="Default"
                                            AnimationFrameInterval="0:0:0.016"
                                            AnimationPlaybackRate="1"
                                            Path="{Binding IconPath}" />

                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Foreground="#F4F6FA"
                                            Text="{Binding TemperatureMax}" />

                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#737C8C"
                                            Text="{Binding TemperatureMin}" />

                                    </StackPanel>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </ScrollViewer>


                    <!-- SUNRISE / SUNSET -->

                    <Grid
                        Margin="0,2,0,0"
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10">

                        <Border
                            Grid.Column="0"
                            Padding="11"
                            Background="#18202C"
                            CornerRadius="11">

                            <StackPanel Spacing="2">

                                <TextBlock
                                    FontSize="11"
                                    Foreground="#737C8C"
                                    Text="Восход" />

                                <TextBlock
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="#E8ECF2"
                                    Text="{Binding Sunrise}" />

                            </StackPanel>

                        </Border>

                        <Border
                            Grid.Column="1"
                            Padding="11"
                            Background="#18202C"
                            CornerRadius="11">

                            <StackPanel Spacing="2">

                                <TextBlock
                                    FontSize="11"
                                    Foreground="#737C8C"
                                    Text="Закат" />

                                <TextBlock
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="#E8ECF2"
                                    Text="{Binding Sunset}" />

                            </StackPanel>

                        </Border>

                    </Grid>

                </StackPanel>

            </Border>

        </Grid>

    </ScrollViewer>

</UserControl>