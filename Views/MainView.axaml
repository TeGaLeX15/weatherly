<!--  Views/MainView.axaml  -->
<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
    xmlns:components="using:Weatherly.Views.Components"
    x:Class="Weatherly.Views.MainView">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">

        <Grid
            MaxWidth="1140"
            Margin="24"
            HorizontalAlignment="Center"
            RowDefinitions="Auto,Auto,Auto,Auto,Auto"
            RowSpacing="18">

            <!-- HEADER -->

            <Grid
                Grid.Row="0"
                ColumnDefinitions="*,Auto"
                VerticalAlignment="Center">

                <StackPanel
                    Grid.Column="0"
                    Spacing="2">

                    <TextBlock
                        FontSize="26"
                        FontWeight="SemiBold"
                        Foreground="#F4F6FA"
                        Text="Щучинск" />

                    <TextBlock
                        FontSize="13"
                        Foreground="#8E96A6"
                        Text="Вторник, 8 сентября" />

                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="6">

                    <Button
                        Width="40"
                        Height="40"
                        Padding="0"
                        Background="#151A24"
                        BorderBrush="#232B38"
                        BorderThickness="1"
                        CornerRadius="11"
                        Content="↻"
                        FontSize="19"
                        Foreground="#B7BECA" />

                    <Button
                        Width="40"
                        Height="40"
                        Padding="0"
                        Background="#151A24"
                        BorderBrush="#232B38"
                        BorderThickness="1"
                        CornerRadius="11"
                        Content="⚙"
                        FontSize="17"
                        Foreground="#B7BECA" />

                </StackPanel>

            </Grid>


            <!-- CURRENT WEATHER -->

            <Border
                Grid.Row="1"
                Background="#151A24"
                BorderBrush="#232B38"
                BorderThickness="1"
                CornerRadius="22"
                Padding="22">

                <Grid
                    ColumnDefinitions="*,280"
                    VerticalAlignment="Center">

                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Spacing="9">

                        <TextBlock
                            FontSize="58"
                            FontWeight="SemiBold"
                            Foreground="#F4F6FA"
                            Text="14°" />

                        <TextBlock
                            FontSize="20"
                            Foreground="#E8ECF2"
                            Text="Облачно" />

                        <TextBlock
                            FontSize="14"
                            Foreground="#8E96A6"
                            Text="Ощущается как 12°" />

                        <Grid
                            Margin="0,8,0,0"
                            ColumnDefinitions="Auto,Auto,Auto"
                            ColumnSpacing="24">

                            <StackPanel
                                Grid.Column="0"
                                Spacing="2">

                                <TextBlock
                                    FontSize="11"
                                    Foreground="#737C8C"
                                    Text="Сегодня" />

                                <TextBlock
                                    FontSize="15"
                                    Foreground="#B7BECA"
                                    Text="10° — 16°" />

                            </StackPanel>

                            <StackPanel
                                Grid.Column="1"
                                Spacing="2">

                                <TextBlock
                                    FontSize="11"
                                    Foreground="#737C8C"
                                    Text="Ветер" />

                                <TextBlock
                                    FontSize="15"
                                    Foreground="#B7BECA"
                                    Text="4 м/с" />

                            </StackPanel>

                            <StackPanel
                                Grid.Column="2"
                                Spacing="2">

                                <TextBlock
                                    FontSize="11"
                                    Foreground="#737C8C"
                                    Text="Влажность" />

                                <TextBlock
                                    FontSize="15"
                                    Foreground="#B7BECA"
                                    Text="71%" />

                            </StackPanel>

                        </Grid>

                    </StackPanel>


                    <components:WeatherScene
                        Grid.Column="1"
                        Width="280"
                        Height="230"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />

                </Grid>

            </Border>


            <!-- HOURLY -->

            <StackPanel
                Grid.Row="2"
                Spacing="9">

                <TextBlock
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="#F4F6FA"
                    Text="Почасовой прогноз" />

                <ScrollViewer
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled">

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8">


                        <!-- 14 -->

                        <Border
                            Width="142"
                            Height="196"
                            Padding="6"
                            Background="#18202C"
                            CornerRadius="16">

                            <Grid
                                RowDefinitions="Auto,128,Auto"
                                VerticalAlignment="Center">

                                <TextBlock
                                    Grid.Row="0"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#8E96A6"
                                    Text="14:00" />

                                <Grid
                                    Grid.Row="1"
                                    Width="128"
                                    Height="128">

                                    <svg:Svg
                                        Width="128"
                                        Height="128"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Stretch="Uniform"
                                        EnableCache="True"
                                        AnimationBackend="Default"
                                        AnimationFrameInterval="0:0:0.016"
                                        AnimationPlaybackRate="1"
                                        Path="/Assets/Weather/overcast.svg" />

                                </Grid>

                                <TextBlock
                                    Grid.Row="2"
                                    HorizontalAlignment="Center"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="#F4F6FA"
                                    Text="14°" />

                            </Grid>

                        </Border>


                        <!-- 15 -->

                        <Border
                            Width="142"
                            Height="196"
                            Padding="6"
                            Background="#18202C"
                            CornerRadius="16">

                            <Grid
                                RowDefinitions="Auto,128,Auto"
                                VerticalAlignment="Center">

                                <TextBlock
                                    Grid.Row="0"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#8E96A6"
                                    Text="15:00" />

                                <Grid
                                    Grid.Row="1"
                                    Width="128"
                                    Height="128">

                                    <svg:Svg
                                        Width="128"
                                        Height="128"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Stretch="Uniform"
                                        EnableCache="True"
                                        AnimationBackend="Default"
                                        AnimationFrameInterval="0:0:0.016"
                                        AnimationPlaybackRate="1"
                                        Path="/Assets/Weather/partly-cloudy-day.svg" />

                                </Grid>

                                <TextBlock
                                    Grid.Row="2"
                                    HorizontalAlignment="Center"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="#F4F6FA"
                                    Text="15°" />

                            </Grid>

                        </Border>


                        <!-- 16 -->

                        <Border
                            Width="142"
                            Height="196"
                            Padding="6"
                            Background="#18202C"
                            CornerRadius="16">

                            <Grid
                                RowDefinitions="Auto,128,Auto"
                                VerticalAlignment="Center">

                                <TextBlock
                                    Grid.Row="0"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#8E96A6"
                                    Text="16:00" />

                                <Grid
                                    Grid.Row="1"
                                    Width="128"
                                    Height="128">

                                    <svg:Svg
                                        Width="128"
                                        Height="128"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Stretch="Uniform"
                                        EnableCache="True"
                                        AnimationBackend="Default"
                                        AnimationFrameInterval="0:0:0.016"
                                        AnimationPlaybackRate="1"
                                        Path="/Assets/Weather/overcast.svg" />

                                </Grid>

                                <TextBlock
                                    Grid.Row="2"
                                    HorizontalAlignment="Center"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="#F4F6FA"
                                    Text="16°" />

                            </Grid>

                        </Border>


                        <!-- 17 -->

                        <Border
                            Width="142"
                            Height="196"
                            Padding="6"
                            Background="#18202C"
                            CornerRadius="16">

                            <Grid
                                RowDefinitions="Auto,128,Auto"
                                VerticalAlignment="Center">

                                <TextBlock
                                    Grid.Row="0"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#8E96A6"
                                    Text="17:00" />

                                <Grid
                                    Grid.Row="1"
                                    Width="128"
                                    Height="128">

                                    <svg:Svg
                                        Width="128"
                                        Height="128"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Stretch="Uniform"
                                        EnableCache="True"
                                        AnimationBackend="Default"
                                        AnimationFrameInterval="0:0:0.016"
                                        AnimationPlaybackRate="1"
                                        Path="/Assets/Weather/rain.svg" />

                                </Grid>

                                <TextBlock
                                    Grid.Row="2"
                                    HorizontalAlignment="Center"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="#F4F6FA"
                                    Text="15°" />

                            </Grid>

                        </Border>


                        <!-- 18 -->

                        <Border
                            Width="142"
                            Height="196"
                            Padding="6"
                            Background="#18202C"
                            CornerRadius="16">

                            <Grid
                                RowDefinitions="Auto,128,Auto"
                                VerticalAlignment="Center">

                                <TextBlock
                                    Grid.Row="0"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#8E96A6"
                                    Text="18:00" />

                                <Grid
                                    Grid.Row="1"
                                    Width="128"
                                    Height="128">

                                    <svg:Svg
                                        Width="128"
                                        Height="128"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Stretch="Uniform"
                                        EnableCache="True"
                                        AnimationBackend="Default"
                                        AnimationFrameInterval="0:0:0.016"
                                        AnimationPlaybackRate="1"
                                        Path="/Assets/Weather/rain.svg" />

                                </Grid>

                                <TextBlock
                                    Grid.Row="2"
                                    HorizontalAlignment="Center"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="#F4F6FA"
                                    Text="14°" />

                            </Grid>

                        </Border>


                        <!-- 19 -->

                        <Border
                            Width="142"
                            Height="196"
                            Padding="6"
                            Background="#18202C"
                            CornerRadius="16">

                            <Grid
                                RowDefinitions="Auto,128,Auto"
                                VerticalAlignment="Center">

                                <TextBlock
                                    Grid.Row="0"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#8E96A6"
                                    Text="19:00" />

                                <Grid
                                    Grid.Row="1"
                                    Width="128"
                                    Height="128">

                                    <svg:Svg
                                        Width="128"
                                        Height="128"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Stretch="Uniform"
                                        EnableCache="True"
                                        AnimationBackend="Default"
                                        AnimationFrameInterval="0:0:0.016"
                                        AnimationPlaybackRate="1"
                                        Path="/Assets/Weather/rain.svg" />

                                </Grid>

                                <TextBlock
                                    Grid.Row="2"
                                    HorizontalAlignment="Center"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="#F4F6FA"
                                    Text="13°" />

                            </Grid>

                        </Border>


                        <!-- 20 -->

                        <Border
                            Width="142"
                            Height="196"
                            Padding="6"
                            Background="#18202C"
                            CornerRadius="16">

                            <Grid
                                RowDefinitions="Auto,128,Auto"
                                VerticalAlignment="Center">

                                <TextBlock
                                    Grid.Row="0"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#8E96A6"
                                    Text="20:00" />

                                <Grid
                                    Grid.Row="1"
                                    Width="128"
                                    Height="128">

                                    <svg:Svg
                                        Width="128"
                                        Height="128"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Stretch="Uniform"
                                        EnableCache="True"
                                        AnimationBackend="Default"
                                        AnimationFrameInterval="0:0:0.016"
                                        AnimationPlaybackRate="1"
                                        Path="/Assets/Weather/clear-night.svg" />

                                </Grid>

                                <TextBlock
                                    Grid.Row="2"
                                    HorizontalAlignment="Center"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="#F4F6FA"
                                    Text="12°" />

                            </Grid>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

            </StackPanel>


            <!-- ANALYSIS -->

            <Grid
                Grid.Row="3"
                ColumnDefinitions="*,*"
                ColumnSpacing="12">

                <Border
                    Grid.Column="0"
                    Background="#151A24"
                    BorderBrush="#232B38"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="18">

                    <StackPanel Spacing="9">

                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="#F4F6FA"
                            Text="Анализ дня" />

                        <TextBlock
                            FontSize="14"
                            Foreground="#B7BECA"
                            TextWrapping="Wrap"
                            Text="День будет прохладным и преимущественно облачным. Во второй половине дня вероятность дождя увеличится." />

                        <Border
                            Padding="10"
                            Background="#18202C"
                            CornerRadius="10">

                            <StackPanel Spacing="2">

                                <TextBlock
                                    FontSize="11"
                                    Foreground="#737C8C"
                                    Text="Лучшее время для прогулки" />

                                <TextBlock
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="#E8ECF2"
                                    Text="14:00–16:00" />

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </Border>


                <Border
                    Grid.Column="1"
                    Background="#151A24"
                    BorderBrush="#232B38"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="18">

                    <StackPanel Spacing="9">

                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="#F4F6FA"
                            Text="Что надеть" />

                        <TextBlock
                            FontSize="14"
                            Foreground="#B7BECA"
                            TextWrapping="Wrap"
                            Text="Лёгкая куртка или худи. К вечеру станет прохладнее, поэтому лучше взять дополнительный слой." />

                        <Border
                            Padding="10"
                            Background="#18202C"
                            CornerRadius="10">

                            <StackPanel Spacing="2">

                                <TextBlock
                                    FontSize="11"
                                    Foreground="#737C8C"
                                    Text="Совет" />

                                <TextBlock
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="#E8ECF2"
                                    Text="Зонт пригодится после 17:00" />

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </Border>

            </Grid>


            <!-- WEEKLY -->

            <Border
                Grid.Row="4"
                Background="#151A24"
                BorderBrush="#232B38"
                BorderThickness="1"
                CornerRadius="18"
                Padding="18">

                <StackPanel Spacing="14">

                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="#F4F6FA"
                        Text="Прогноз на 7 дней" />

                    <ScrollViewer
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled">

                        <Grid
                            ColumnDefinitions="142,142,142,142,142,142,142"
                            ColumnSpacing="6">


                            <!-- TODAY -->

                            <StackPanel
                                Grid.Column="0"
                                HorizontalAlignment="Center"
                                Spacing="5">

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#8E96A6"
                                    Text="Сегодня" />

                                <Grid
                                    Width="128"
                                    Height="128">

                                    <svg:Svg
                                        Width="128"
                                        Height="128"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Stretch="Uniform"
                                        EnableCache="True"
                                        AnimationBackend="Default"
                                        AnimationFrameInterval="0:0:0.016"
                                        AnimationPlaybackRate="1"
                                        Path="/Assets/Weather/overcast.svg" />

                                </Grid>

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="#F4F6FA"
                                    Text="16°" />

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#737C8C"
                                    Text="10°" />

                            </StackPanel>


                            <!-- WEDNESDAY -->

                            <StackPanel
                                Grid.Column="1"
                                HorizontalAlignment="Center"
                                Spacing="5">

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#8E96A6"
                                    Text="Ср" />

                                <Grid
                                    Width="128"
                                    Height="128">

                                    <svg:Svg
                                        Width="128"
                                        Height="128"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Stretch="Uniform"
                                        EnableCache="True"
                                        AnimationBackend="Default"
                                        AnimationFrameInterval="0:0:0.016"
                                        AnimationPlaybackRate="1"
                                        Path="/Assets/Weather/rain.svg" />

                                </Grid>

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="#F4F6FA"
                                    Text="14°" />

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#737C8C"
                                    Text="8°" />

                            </StackPanel>


                            <!-- THURSDAY -->

                            <StackPanel
                                Grid.Column="2"
                                HorizontalAlignment="Center"
                                Spacing="5">

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#8E96A6"
                                    Text="Чт" />

                                <Grid
                                    Width="128"
                                    Height="128">

                                    <svg:Svg
                                        Width="128"
                                        Height="128"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Stretch="Uniform"
                                        EnableCache="True"
                                        AnimationBackend="Default"
                                        AnimationFrameInterval="0:0:0.016"
                                        AnimationPlaybackRate="1"
                                        Path="/Assets/Weather/partly-cloudy-day.svg" />

                                </Grid>

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="#F4F6FA"
                                    Text="17°" />

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#737C8C"
                                    Text="9°" />

                            </StackPanel>


                            <!-- FRIDAY -->

                            <StackPanel
                                Grid.Column="3"
                                HorizontalAlignment="Center"
                                Spacing="5">

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#8E96A6"
                                    Text="Пт" />

                                <Grid
                                    Width="128"
                                    Height="128">

                                    <svg:Svg
                                        Width="128"
                                        Height="128"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Stretch="Uniform"
                                        EnableCache="True"
                                        AnimationBackend="Default"
                                        AnimationFrameInterval="0:0:0.016"
                                        AnimationPlaybackRate="1"
                                        Path="/Assets/Weather/clear-day.svg" />

                                </Grid>

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="#F4F6FA"
                                    Text="19°" />

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#737C8C"
                                    Text="10°" />

                            </StackPanel>


                            <!-- SATURDAY -->

                            <StackPanel
                                Grid.Column="4"
                                HorizontalAlignment="Center"
                                Spacing="5">

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#8E96A6"
                                    Text="Сб" />

                                <Grid
                                    Width="128"
                                    Height="128">

                                    <svg:Svg
                                        Width="128"
                                        Height="128"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Stretch="Uniform"
                                        EnableCache="True"
                                        AnimationBackend="Default"
                                        AnimationFrameInterval="0:0:0.016"
                                        AnimationPlaybackRate="1"
                                        Path="/Assets/Weather/clear-day.svg" />

                                </Grid>

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="#F4F6FA"
                                    Text="20°" />

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#737C8C"
                                    Text="11°" />

                            </StackPanel>


                            <!-- SUNDAY -->

                            <StackPanel
                                Grid.Column="5"
                                HorizontalAlignment="Center"
                                Spacing="5">

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#8E96A6"
                                    Text="Вс" />

                                <Grid
                                    Width="128"
                                    Height="128">

                                    <svg:Svg
                                        Width="128"
                                        Height="128"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Stretch="Uniform"
                                        EnableCache="True"
                                        AnimationBackend="Default"
                                        AnimationFrameInterval="0:0:0.016"
                                        AnimationPlaybackRate="1"
                                        Path="/Assets/Weather/overcast.svg" />

                                </Grid>

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="#F4F6FA"
                                    Text="18°" />

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#737C8C"
                                    Text="9°" />

                            </StackPanel>


                            <!-- MONDAY -->

                            <StackPanel
                                Grid.Column="6"
                                HorizontalAlignment="Center"
                                Spacing="5">

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#8E96A6"
                                    Text="Пн" />

                                <Grid
                                    Width="128"
                                    Height="128">

                                    <svg:Svg
                                        Width="128"
                                        Height="128"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Stretch="Uniform"
                                        EnableCache="True"
                                        AnimationBackend="Default"
                                        AnimationFrameInterval="0:0:0.016"
                                        AnimationPlaybackRate="1"
                                        Path="/Assets/Weather/rain.svg" />

                                </Grid>

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="#F4F6FA"
                                    Text="15°" />

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#737C8C"
                                    Text="8°" />

                            </StackPanel>

                        </Grid>

                    </ScrollViewer>


                    <!-- SUNRISE / SUNSET -->

                    <Grid
                        Margin="0,2,0,0"
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10">

                        <Border
                            Grid.Column="0"
                            Padding="11"
                            Background="#18202C"
                            CornerRadius="11">

                            <StackPanel Spacing="2">

                                <TextBlock
                                    FontSize="11"
                                    Foreground="#737C8C"
                                    Text="Восход" />

                                <TextBlock
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="#E8ECF2"
                                    Text="06:42" />

                            </StackPanel>

                        </Border>

                        <Border
                            Grid.Column="1"
                            Padding="11"
                            Background="#18202C"
                            CornerRadius="11">

                            <StackPanel Spacing="2">

                                <TextBlock
                                    FontSize="11"
                                    Foreground="#737C8C"
                                    Text="Закат" />

                                <TextBlock
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="#E8ECF2"
                                    Text="19:37" />

                            </StackPanel>

                        </Border>

                    </Grid>

                </StackPanel>

            </Border>

        </Grid>

    </ScrollViewer>

</UserControl>
