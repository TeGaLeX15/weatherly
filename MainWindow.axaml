<!--  MainWindow.axaml  -->
<Window
    x:Class="Weatherly.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Weatherly.Views"
    Title="Weatherly"
    Width="1280"
    Height="900"
    MinWidth="1000"
    MinHeight="700"
    Background="#0D1017"
    WindowStartupLocation="CenterScreen">

    <views:MainView />
    
</Window>