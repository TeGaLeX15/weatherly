<!-- Styles/Cards.axaml -->
<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="Border.glass-card">

        <Setter
            Property="Background"
            Value="{StaticResource BrushGlass}" />

        <Setter
            Property="BorderBrush"
            Value="{StaticResource BrushBorder}" />

        <Setter
            Property="BorderThickness"
            Value="1" />

        <Setter
            Property="CornerRadius"
            Value="22" />

        <Setter
            Property="BoxShadow"
            Value="0 16 40 0 #50000000" />

    </Style>


    <Style Selector="Border.glass-card-strong">

        <Setter
            Property="Background"
            Value="{StaticResource BrushGlassElevated}" />

        <Setter
            Property="BorderBrush"
            Value="{StaticResource BrushBorderStrong}" />

        <Setter
            Property="BorderThickness"
            Value="1" />

        <Setter
            Property="CornerRadius"
            Value="22" />

        <Setter
            Property="BoxShadow"
            Value="0 20 48 0 #65000000" />

    </Style>


    <Style Selector="Border.glass-tile">

        <Setter
            Property="Background"
            Value="{StaticResource BrushGlassSoft}" />

        <Setter
            Property="BorderBrush"
            Value="{StaticResource BrushBorderSoft}" />

        <Setter
            Property="BorderThickness"
            Value="1" />

        <Setter
            Property="CornerRadius"
            Value="16" />

    </Style>


    <Style Selector="Border.weather-hero-card">

        <Setter
            Property="Background"
            Value="{StaticResource BrushGlassElevated}" />

        <Setter
            Property="BorderBrush"
            Value="{StaticResource BrushBorderStrong}" />

        <Setter
            Property="BorderThickness"
            Value="1" />

        <Setter
            Property="CornerRadius"
            Value="26" />

        <Setter
            Property="BoxShadow"
            Value="0 22 56 0 #70000000" />

    </Style>


    <Style Selector="Border.forecast-card">

        <Setter
            Property="Background"
            Value="{StaticResource BrushGlassSoft}" />

        <Setter
            Property="BorderBrush"
            Value="{StaticResource BrushBorder}" />

        <Setter
            Property="BorderThickness"
            Value="1" />

        <Setter
            Property="CornerRadius"
            Value="16" />

    </Style>

</Styles>